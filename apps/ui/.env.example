API_URL=http://localhost:3000
AUTH_PROXY_SECRET="<same-random-secret-in-api-and-ui-at-least-32-characters>"
# Comma-separated IPs of trusted reverse proxies; empty means direct clients.
UI_TRUSTED_PROXIES=
# Public origin for track mutation CSRF checks behind a reverse proxy (no trailing slash).
# Without a proxy this can be omitted; the request URL origin is used.
UI_ORIGIN=http://localhost:3001
