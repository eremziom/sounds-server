{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs --dev --port 3001",
    "build": "node --experimental-strip-types scripts/check-messages.mjs && next build",
    "start": "node server.mjs",
    "lint": "eslint",
    "test": "node --experimental-strip-types scripts/check-messages.mjs && node --experimental-strip-types --test tests/*.test.mjs",
    "check:messages": "node --experimental-strip-types scripts/check-messages.mjs",
    "test:routing": "node --test tests/routing.integration.mjs",
    "test:browser": "node tests/i18n.browser.mjs && node tests/register.browser.mjs && node tests/login.browser.mjs && node tests/auth-forms.browser.mjs && node tests/logout.browser.mjs && node tests/application-runtime.browser.mjs && node tests/session-ending.browser.mjs && node tests/session-resume.browser.mjs && node tests/session-deadline.browser.mjs",
    "test:runtime": "node tests/application-runtime.browser.mjs",
    "test:session-ending": "node tests/session-ending.browser.mjs",
    "test:session-resume": "node tests/session-resume.browser.mjs",
    "test:session-deadline": "node tests/session-deadline.browser.mjs",
    "test:auth-api": "node --experimental-strip-types tests/auth-api.integration.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/validator": "^13.15.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.9.1"
}
