generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  generatedFileExtension = "cts"
  importFileExtension    = "cjs"
  moduleFormat           = "cjs"
}

datasource db {
  provider = "postgresql"
}

model AuthRateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

model Track {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  publicationDate DateTime @default(now())
  genre       String?    @db.VarChar(30)
  subgenre    String?    @db.VarChar(30)
  bpmFrom     Int?
  bpmTo       Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  ownerId     Int?
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  audioFile   AudioFile?

  @@index([ownerId])
}

model AudioFile {
  id           Int      @id @default(autoincrement())
  trackId      Int      @unique
  storageKey   String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
  track        Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

enum AudioUploadStatus {
  PENDING
  CONSUMED
  CANCELLED
  EXPIRED
}

model AudioUpload {
  id           String            @id @default(uuid())
  ownerId      Int
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  storageKey   String            @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime          @default(now())
  expiresAt    DateTime
  status       AudioUploadStatus @default(PENDING)

  @@index([status, expiresAt])
  @@index([ownerId])
}

model User {
  id              Int           @id @default(autoincrement())
  /// Must not contain @; enforced by the User_username_no_at SQL CHECK constraint.
  username        String        @unique
  password        String
  email           String        @unique
  bio             String?
  avatar          String?
  isActive        Boolean       @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  roles           UserRole[]
  sessions        AuthSession[]
  tracks          Track[]
  audioUploads    AudioUpload[]
}

model AuthSession {
  id             String         @id @default(uuid())
  userId         Int
  createdAt      DateTime       @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  rotationResult String?
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]

  @@index([userId, revokedAt])
}

model RefreshToken {
  tokenHash String      @id
  sessionId String
  createdAt DateTime    @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Role {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}
