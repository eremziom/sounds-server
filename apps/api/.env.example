DATABASE_URL="postgresql://postgres:<password>@HOST:PORT/DATABASE"
JWT_SECRET="<strong-random-secret>"
JWT_EXPIRES_IN="1d"
AUTH_PROXY_SECRET="<same-random-secret-in-api-and-ui-at-least-32-characters>"
# Absolute private path, outside public/source/build directories.
AUDIO_STORAGE_DIR="D:/Sandbox/sounds-server/storage/audio"
AUDIO_MAX_FILE_BYTES="52428800"
# Separate private store for creator sources, maps and reports (PNG/JSON).
ARTWORK_STORAGE_DIR="D:/Sandbox/sounds-server/storage/artworks"
# Disposable per-attempt files; separate from audio and committed artwork stores.
ARTWORK_JOB_ROOT="D:/Sandbox/sounds-server/storage/artwork-jobs"
# Optional queue polling interval, 250..30000 ms; default 5000.
# ARTWORK_POLL_MS="5000"
# Optional overrides; defaults reuse the pinned KRE-00 environments/weights.
# ARTWORK_CPU_PYTHON="D:/Sandbox/sounds-server/.local/kre00/venvs/onnx/Scripts/python.exe"
# ARTWORK_GPU_PYTHON="D:/Sandbox/sounds-server/.local/kre00/venvs/torch-rocm721/Scripts/python.exe"
# ARTWORK_MODELS_DIR="D:/Sandbox/sounds-server/.local/kre00/models"
