DATABASE_URL="postgresql://postgres:<password>@HOST:PORT/DATABASE"
JWT_SECRET="<strong-random-secret>"
JWT_EXPIRES_IN="1d"
AUTH_PROXY_SECRET="<same-random-secret-in-api-and-ui-at-least-32-characters>"
# Absolute private path, outside public/source/build directories.
AUDIO_STORAGE_DIR="D:/Sandbox/sounds-server/storage/audio"
AUDIO_MAX_FILE_BYTES="52428800"
# Separate private store for creator sources, maps and reports (PNG/JSON).
ARTWORK_STORAGE_DIR="D:/Sandbox/sounds-server/storage/artworks"
