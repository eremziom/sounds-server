{
  "name": "sounds",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter ui dev",
    "dev:api": "pnpm --filter api dev",
    "dev:ui": "pnpm --filter ui dev",
    "build": "pnpm -r build",
    "format": "pnpm -r format",
    "start": "pnpm --filter api start",
    "start:dev": "pnpm --filter api start:dev",
    "start:debug": "pnpm --filter api start:debug",
    "start:prod": "pnpm --filter api start:prod",
    "lint": "pnpm -r lint",
    "check:messages": "pnpm --filter ui check:messages",
    "devtest": "pnpm --filter api devtest",
    "devtest:ui": "pnpm --filter ui test && pnpm --filter ui exec tsc --noEmit",
    "verify:i18n": "pnpm --filter ui lint && pnpm devtest:ui && pnpm --filter ui build && pnpm --filter ui test:routing && pnpm --filter ui test:browser && pnpm --filter api exec jest --runInBand",
    "seed:rbac": "pnpm --filter api seed:rbac",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter api test:watch",
    "test:cov": "pnpm --filter api test:cov",
    "test:debug": "pnpm --filter api test:debug",
    "test:e2e": "pnpm --filter api test:e2e",
    "test:auth-sessions": "pnpm --filter api test:auth-sessions",
    "test:auth-api": "pnpm --filter api build && pnpm --filter ui test:auth-api"
  }
}
