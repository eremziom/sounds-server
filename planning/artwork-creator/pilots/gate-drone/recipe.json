{
  "version": 1,
  "title": "KRE-03 Night Garden Flight",
  "brief": {
    "intent": "KRE-03 layered night garden with an integral flying survey drone",
    "guidelinesVersion": "1.7",
    "guidelinesPath": "apps/ui/src/engines/infinite-zoom/artwork-authoring-guidelines.md",
    "composition": "Dark alien garden and mossed stone gateway at right, thick foreground pillar near x=68%; small compact cyan drone at x=25%, y=45%, width 10%; open middle flight space.",
    "motionPlan": "Separate drone visibility and lamp layers; 24-second curved left-to-right flight behind the right pillar, tangent rotation about measured mask centroid; inpaint its entire revealed backing. No searchlight beam, trail or baked glow.",
    "lightingPlan": "Many dozens of fine stone fissures and leaf-vein bands across three garden groups; saturated cyan-magenta-amber gradients along material, dark gaps preserved; distinct visibility, influence and delay maps, staggered local impulses and bass binding.",
    "blackoutPlan": "Opaque black coverage; independently animated garden details and drone lamps remain visible from the start while environment and hull reach zero opacity. Smooth eight-second reveal and return; pause and zoom QA required.",
    "qaPlan": "Inspect mask contours, inpainted backing, full curved flight, pillar occlusion, color cycles/propagation, blackout/reveal shadows, zoom, pause/reset and portrait/wide coverage. Record motion and uncertain boundaries; no still-only acceptance."
  },
